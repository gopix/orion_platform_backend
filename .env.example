# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=orion_db

# Upload settings
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=104857600
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain
STORAGE_PROVIDER=local

# Logging settings
LOG_DIR=/app/logs
LOG_LEVEL=INFO

# Web accessibility scanning (src/modules/accessibility_web) - SSRF guard.
# Comma-separated hosts/IPs or CIDR blocks allowed to be scanned even though
# they're private/reserved addresses (acquisition/url_guard.py). Leave empty
# unless you have a specific internal target you deliberately want scannable.
# Example: SCAN_PRIVATE_IP_ALLOWLIST=10.20.0.0/24,staging.internal.orion.local
SCAN_PRIVATE_IP_ALLOWLIST=

# Book Forge chunking (how documents are split before embedding)
# strategy: heading | paragraph | fixed | semantic
#   heading  - split on headings; with CHUNK_MAX_SIZE also carves oversized
#              sections on paragraph boundaries (degrades well on plain PDFs)
#   fixed    - uniform CHUNK_SIZE-token windows with CHUNK_OVERLAP overlap
CHUNK_STRATEGY=heading
CHUNK_SIZE=512          # target tokens per chunk (fixed/semantic)
CHUNK_OVERLAP=50        # overlap tokens between windows (fixed)
CHUNK_MIN_SIZE=150      # merge chunks smaller than this into a neighbour
CHUNK_MAX_SIZE=600      # split any section larger than this
CHUNK_MERGE_SMALL=true

# Book Forge blueprint (RAG generation of the chapter outline)
BLUEPRINT_TOP_K=20                  # chunks retrieved for the blueprint stage
BLUEPRINT_QUESTIONS_PER_CHAPTER=40  # avg questions/chapter (scaled by weightage)
